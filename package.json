{
  "name": "timber-structure-designer",
  "private": true,
  "version": "0.1.16",
  "type": "module",
  "description": "Client-side 3D parametric timber structure designer (carports, garden sheds, Überdachungen)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
