{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "vite-dev-auto",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx vite --port \"$PORT\" --strictPort"
      ],
      "autoPort": true,
      "port": 5182
    }
  ]
}
